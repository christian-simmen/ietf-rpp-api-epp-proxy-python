{
  "description": "A template has 8 to 1024 characters (docs/rri/rri-extension.md); the proxy refuses a shorter one before any command.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/requestContacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "requestContact",
          "id": "{handle:a:RQ6}",
          "uriTemplate": "http://"
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
