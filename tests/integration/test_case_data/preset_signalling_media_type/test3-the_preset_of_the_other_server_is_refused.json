{
  "markers": [
    "smoke"
  ],
  "test_id": "test3-the_preset_of_the_other_server_is_refused",
  "description": "A preset the server does not offer in the Accept of a request whose Content-Type is offered (base): the Accept lists no preset the server offers, 406 with RPP-Code 02004 (core 14.3).",
  "when": {
    "env.preset_signalling": "media-type"
  },
  "steps": [
    {
      "when": {
        "profile.presets": {
          "not": {
            "contains": "epp-compatible"
          }
        }
      },
      "request": {
        "method": "GET",
        "url": "/domainNames/b3-{random_id_10}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:epp-compatible\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\""
        }
      },
      "response": {
        "status": 406,
        "headers": {
          "RPP-Code": "02004",
          "RPP-Preset": null,
          "Vary": "Accept"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "when": {
        "profile.presets": {
          "not": {
            "contains": "rri"
          }
        }
      },
      "request": {
        "method": "GET",
        "url": "/domainNames/b3-{random_id_10}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"de.denic.rpp.preset.rri\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\""
        }
      },
      "response": {
        "status": 406,
        "headers": {
          "RPP-Code": "02004",
          "RPP-Preset": null,
          "Vary": "Accept"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
