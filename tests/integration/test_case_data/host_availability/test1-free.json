{
  "markers": ["smoke"],
  "test_id": "test1-free",
  "steps": [
    {
      "comment": "Checks whether host t1.….net is available; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "GET",
        "url": "/hosts/t1.{random_name}.net/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "hostAvailability",
          "available": true
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
