{
  "markers": ["smoke"],
  "test_id": "test4-auth_info",
  "description": "A new authInfo is accepted by PATCH.",
  "steps": [
    {
      "comment": "Creates contact L4 with authInfo (the request differs by backend); expects 201 01000. Setup: the registrant of the domain below.",
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "contact",
                "id": "{handle:a:L4}",
                "contactInfo": {
                  "@type": "Card",
                  "version": "2.0",
                  "kind": "individual",
                  "name": {
                    "full": "Erika Mustermann"
                  },
                  "addresses": {
                    "addr": {
                      "components": [
                        {
                          "kind": "name",
                          "value": "Musterweg 12"
                        },
                        {
                          "kind": "locality",
                          "value": "Frankfurt am Main"
                        },
                        {
                          "kind": "postcode",
                          "value": "60596"
                        }
                      ],
                      "countryCode": "DE"
                    }
                  },
                  "emails": {
                    "email": {
                      "address": "erika@example.com"
                    }
                  },
                  "phones": {
                    "voice": {
                      "number": "tel:+49.6912345678",
                      "features": {
                        "voice": true
                      }
                    }
                  }
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            },
            {
              "then": {
                "@type": "contact",
                "id": "{handle:a:L4}",
                "contactInfo": {
                  "@type": "Card",
                  "version": "2.0",
                  "kind": "individual",
                  "name": {
                    "full": "Erika Mustermann"
                  },
                  "addresses": {
                    "addr": {
                      "components": [
                        {
                          "kind": "name",
                          "value": "Musterweg 12"
                        },
                        {
                          "kind": "locality",
                          "value": "Frankfurt am Main"
                        },
                        {
                          "kind": "postcode",
                          "value": "60596"
                        }
                      ],
                      "countryCode": "DE"
                    }
                  },
                  "emails": {
                    "email": {
                      "address": "erika@example.com"
                    }
                  },
                  "phones": {
                    "voice": {
                      "number": "tel:+49.6912345678",
                      "features": {
                        "voice": true
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "contact",
          "id": "{handle:a:L4}"
        }
      }
    },
    {
      "comment": "Creates domain t4 with registrant L4, dns records a, authInfo (the request differs by backend); expects 201 01000. Setup: the domain the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "domainName",
                "name": "t4-{random_name}.{tld}",
                "registrant": {
                  "@type": "contact",
                  "id": "{handle:a:L4}"
                },
                "dns": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            },
            {
              "then": {
                "@type": "domainName",
                "name": "t4-{random_name}.{tld}",
                "registrant": {
                  "@type": "contact",
                  "id": "{handle:a:L4}"
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "domainName",
          "name": "t4-{random_name}.{tld}",
          "registrant": {
            "id": "{handle:a:L4}"
          }
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          }
        }
      }
    },
    {
      "comment": "Patches domain t4: replace /authInfo; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t4-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/authInfo",
            "value": {
              "@type": "authInfo",
              "method": "authinfo",
              "authdata": "Abc2345678"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Reads domain t4 (includeElements=authInfo); expects 200. Reads back to prove the change above.",
      "request": {
        "method": "GET",
        "url": "/domainNames/t4-{random_name}.{tld}?includeElements=authInfo",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.domainName.authInfo.read_supported": true
            },
            "then": {
              "status": 200,
              "body": {
                "authInfo": {
                  "authdata": "Abc2345678"
                }
              }
            }
          },
          {
            "then": {
              "status": 501,
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              },
              "headers": {
                "RPP-Code": "02102"
              }
            }
          }
        ]
      }
    },
    {
      "comment": "Deletes domain t4; expects 200. Cleanup: MTEST keeps what a case creates, so the case deletes it.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/t4-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    }
  ]
}
