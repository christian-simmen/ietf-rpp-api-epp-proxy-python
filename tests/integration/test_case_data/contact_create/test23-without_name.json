{
  "test_id": "test23-without_name",
  "description": "A contact without a name is refused: the name is required (JSContact profile).",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:K23}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "profile.default_preset": "epp-compatible"
            },
            "then": {
              "status": 422,
              "headers": {
                "RPP-Code": "02308"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          },
          {
            "then": {
              "any_of": [
                {
                  "status": 400,
                  "headers": {
                    "RPP-Code": "02001"
                  },
                  "content_type": "application/problem+json",
                  "body": {
                    "type": "urn:ietf:params:rpp:error"
                  }
                },
                {
                  "status": 400,
                  "headers": {
                    "RPP-Code": "02003"
                  },
                  "content_type": "application/problem+json",
                  "body": {
                    "type": "urn:ietf:params:rpp:error"
                  }
                },
                {
                  "status": 422,
                  "headers": {
                    "RPP-Code": "02306"
                  },
                  "content_type": "application/problem+json",
                  "body": {
                    "type": "urn:ietf:params:rpp:error"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
