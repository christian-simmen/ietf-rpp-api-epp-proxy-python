{
  "markers": [
    "smoke"
  ],
  "test_id": "test6-the_request_preset_is_not_in_the_accept",
  "description": "The preset of the Content-Type, on every request (without content too), must be listed in the Accept: 400 with RPP-Code 02001. A Content-Type without parameters is the default preset of the server (core 14.3).",
  "when": {
    "env.preset_signalling": "media-type"
  },
  "steps": [
    {
      "when": {
        "profile.default_preset": "epp-compatible"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:epp-compatible\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\""
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001",
          "RPP-Preset": null,
          "Vary": "Accept"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "when": {
        "profile.default_preset": "epp-compatible"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json"
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001",
          "RPP-Preset": null,
          "Vary": "Accept"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "when": {
        "profile.default_preset": "rri"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"de.denic.rpp.preset.rri\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\""
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001",
          "RPP-Preset": null,
          "Vary": "Accept"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "when": {
        "profile.default_preset": "rri"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json"
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001",
          "RPP-Preset": null,
          "Vary": "Accept"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:base\"; preset-version=\"1.0\"",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:PB4}"
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001",
          "RPP-Preset": null,
          "Vary": "Accept"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
