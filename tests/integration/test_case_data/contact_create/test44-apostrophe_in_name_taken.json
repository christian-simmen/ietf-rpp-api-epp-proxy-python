{
  "test_id": "test44-apostrophe_in_name_taken",
  "when": {
    "env.contact.name.charset_restricted": false
  },
  "comment": "Skipped on epp-docker: the EPP test server restricts the characters of a contact name; test31 is its twin.",
  "description": "An apostrophe in a name, which US-ASCII allows, read back.",
  "steps": [
    {
      "comment": "Creates contact K44 with authInfo (by backend); expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:K44}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika O'Neill"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "contact",
          "id": "{handle:a:K44}",
          "contactInfo": {
            "name": {
              "full": "Erika O'Neill"
            }
          }
        }
      }
    }
  ]
}
