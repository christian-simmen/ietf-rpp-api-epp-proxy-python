{
  "test_id": "test31-patch_without_change_by_another_client",
  "description": "A partial update by a client that is not the sponsor is refused (core §16.8): on every backend, and a replace of a host object nameserver by itself where the backend has host objects.",
  "steps": [
    {
      "comment": "Creates contact U36 with authInfo (the request differs by backend); expects 201 01000. Setup: the registrant of the domain below.",
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "contact",
                "id": "{handle:a:U36}",
                "contactInfo": {
                  "@type": "Card",
                  "version": "2.0",
                  "kind": "individual",
                  "name": {
                    "full": "Erika Mustermann"
                  },
                  "addresses": {
                    "addr": {
                      "components": [
                        {
                          "kind": "name",
                          "value": "Musterweg 12"
                        },
                        {
                          "kind": "locality",
                          "value": "Frankfurt am Main"
                        },
                        {
                          "kind": "postcode",
                          "value": "60596"
                        }
                      ],
                      "countryCode": "DE"
                    }
                  },
                  "emails": {
                    "email": {
                      "address": "erika@example.com"
                    }
                  },
                  "phones": {
                    "voice": {
                      "number": "tel:+49.6912345678",
                      "features": {
                        "voice": true
                      }
                    }
                  }
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            },
            {
              "then": {
                "@type": "contact",
                "id": "{handle:a:U36}",
                "contactInfo": {
                  "@type": "Card",
                  "version": "2.0",
                  "kind": "individual",
                  "name": {
                    "full": "Erika Mustermann"
                  },
                  "addresses": {
                    "addr": {
                      "components": [
                        {
                          "kind": "name",
                          "value": "Musterweg 12"
                        },
                        {
                          "kind": "locality",
                          "value": "Frankfurt am Main"
                        },
                        {
                          "kind": "postcode",
                          "value": "60596"
                        }
                      ],
                      "countryCode": "DE"
                    }
                  },
                  "emails": {
                    "email": {
                      "address": "erika@example.com"
                    }
                  },
                  "phones": {
                    "voice": {
                      "number": "tel:+49.6912345678",
                      "features": {
                        "voice": true
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "contact",
          "id": "{handle:a:U36}"
        }
      }
    },
    {
      "comment": "Creates domain t36 with registrant U36, dns records a, authInfo (the request differs by backend); expects 201 01000. Setup: the domain the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "domainName",
                "name": "t36-{random_name}.{tld}",
                "registrant": {
                  "@type": "contact",
                  "id": "{handle:a:U36}"
                },
                "dns": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            },
            {
              "then": {
                "@type": "domainName",
                "name": "t36-{random_name}.{tld}",
                "registrant": {
                  "@type": "contact",
                  "id": "{handle:a:U36}"
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "domainName",
          "name": "t36-{random_name}.{tld}",
          "registrant": {
            "id": "{handle:a:U36}"
          }
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          }
        }
      }
    },
    {
      "comment": "Patches domain t36: replace /registrant as registrar b; expects 403 02201. An error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t36-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/registrant",
            "value": {
              "@type": "contact",
              "id": "{handle:a:U36}"
            }
          }
        ]
      },
      "response": {
        "status": 403,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02201"
        }
      }
    },
    {
      "comment": "Deletes domain t36; expects 200. Cleanup: MTEST keeps what a case creates, so the case deletes it.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/t36-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    },
    {
      "comment": "Creates host ns1.u31 with dns records ns; expects 201. Setup: a nameserver of the domain below. Only where the backend has host objects (epp-docker).",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.u31-{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.u31-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "hostName": "ns1.u31-{random_name}.net"
        }
      }
    },
    {
      "comment": "Creates domain put31 with authInfo, 1 nameserver; expects 201 01000. Setup: the domain the steps below work on. Only where the backend has host objects (epp-docker).",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "put31-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "ns1.u31-{random_name}.net"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Patches domain put31: replace /nameservers with a match as registrar b; expects 403 02201. The error answer this case checks. Only where the backend has host objects (epp-docker).",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "/domainNames/put31-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/nameservers",
            "match": {
              "hostName": "{upper:ns1.u31-{random_name}.net}"
            },
            "value": {
              "@type": "host",
              "hostName": "ns1.u31-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "status": 403,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02201"
        }
      }
    }
  ]
}
