{
  "test_id": "test8-malformed_json",
  "steps": [
    {
      "comment": "Sends a domain create without a name or id, with a fixed RPP-Cltrid, a raw body that is no valid JSON; expects 400. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_raw": "\n{\n    \"name: \"FREE.EXAMPLE\",\n    \"authInfo\": {\n        \"pw\": \"Abc2345678\"\n    }\n}\n            ",
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "test8-{random_name}-clTRID",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}"
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "test8-{random_name}-clTRID"
        }
      }
    }
  ]
}
