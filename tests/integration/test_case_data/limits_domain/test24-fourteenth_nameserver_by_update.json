    {
      "comment": "Creates domain t24 with authInfo, registrant X24 (by backend), dns records a (by backend), 13 nameservers; expects 201. Setup: the domain the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t24-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:X24}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "ns1.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns2.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns3.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns4.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns5.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns6.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns7.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns8.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns9.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns10.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns11.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns12.n24-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns13.n24-{random_name}.net"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Patches domain t24: add /nameservers; expects one of 400 02001 or 400 02004 or 400 02005 or 422 02306. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t24-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns14.n24-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "any_of": [
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02001"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02004"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 400,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02005"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          },
          {
            "status": 422,
            "content_type": "application/problem+json",
            "headers": {
              "RPP-Code": "02306"
            },
            "body": {
              "type": "urn:ietf:params:rpp:error"
            }
          }
        ]
      }
    }
  ]
}
