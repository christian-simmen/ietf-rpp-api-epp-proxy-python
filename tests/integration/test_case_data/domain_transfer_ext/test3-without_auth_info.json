{
  "test_id": "test3-without_auth_info",
  "description": "CHPROV needs the AuthInfo: without RPP-Authorization the proxy sends nothing.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/requestContacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "requestContact",
          "id": "{handle:a:RG10}",
          "uriTemplate": "https://example.com/contact?domain={Alabel}"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "requestContact",
          "id": "{handle:a:RG10}"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/requestContacts",
