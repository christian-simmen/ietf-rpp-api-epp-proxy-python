{
  "test_id": "test7-dns_controls_are_unsupported",
  "steps": [
    {
      "comment": "Creates host t7.….net with dns records a, dns controls; expects 501 02103. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t7.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "t7.{random_name}.net.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              }
            ],
            "controls": {
              "@type": "dnsControls",
              "ttl": {
                "a": 3600
              }
            }
          }
        }
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02103"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
