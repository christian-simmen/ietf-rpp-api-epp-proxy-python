{
  "test_id": "test20-second_abuse_contact",
  "when": {
    "profile.domainName.abuse.max_count": {
      "min": 1
    }
  },
  "comment": "Skipped on epp-docker: EPP has no General Request or Abuse contact of a domain.",
  "description": "RRI holds one abuse contact, which the member `abuse` holds: a list of two is refused.",
  "steps": [
    {
      "comment": "Creates request contact RG26 with uriTemplate; expects 201 01000. Setup: the Abuse contact of the domain below.",
      "request": {
        "method": "POST",
        "url": "/requestContacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "requestContact",
          "id": "{handle:a:RG26}",
          "uriTemplate": "https://example.com/contact?domain={Alabel}"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "requestContact",
          "id": "{handle:a:RG26}"
        }
      }
    },
    {
      "comment": "Creates request contact RA26 with uriTemplate; expects 201 01000. Setup: the Abuse contact of the domain below.",
      "request": {
        "method": "POST",
        "url": "/requestContacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "requestContact",
          "id": "{handle:a:RA26}",
          "uriTemplate": "mailto:abuse@example.com"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "requestContact",
          "id": "{handle:a:RA26}"
        }
      }
    },
    {
      "comment": "Creates contact X20 with authInfo (by backend); expects 201. Setup: the registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:X20}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "comment": "Creates domain t20 with authInfo, registrant X20 (by backend), dns records a (by backend); expects 201. Setup: the domain the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "t20-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:X20}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Patches domain t20: add /abuse; expects 200. The operation this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t20-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/abuse",
            "value": {
              "@type": "requestContact",
              "id": "{handle:a:RA26}"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {}
      }
    },
    {
      "comment": "Patches domain t20: add /abuse; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/t20-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/abuse",
            "value": [
              {
                "@type": "requestContact",
                "id": "{handle:a:RA26}"
              },
              {
                "@type": "requestContact",
                "id": "{handle:a:RG26}"
              }
            ]
          }
        ]
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02001"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    },
    {
      "comment": "Deletes domain t20; expects 200. Cleanup: MTEST keeps what a case creates, so the case deletes it.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/t20-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    }
  ]
}
