    {
      "request": {
        "method": "POST",
        "url": "/domainNames/x3-{random_name}.{tld}/processes/transferProcesses",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainTransferProcess",
          "registrant": {
            "@type": "contact",
            "id": "{handle:b:X3}"
          },
          "generalRequest": {
            "@type": "requestContact",
            "id": "{handle:b:RG10}"
          },
          "abuse": {
            "@type": "requestContact",
