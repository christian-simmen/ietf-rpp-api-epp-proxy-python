{
  "markers": [
    "smoke"
  ],
  "test_id": "test1-simple_create",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/planets",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "planet",
          "id": "{handle:a:-sc1}",
          "type": "rocky",
          "radius": 3389.5,
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Secret-Word1"
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "planet",
          "id": "{handle:a:-sc1}"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/satellites",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "satellite",
          "id": "{handle:a:-sc1s}",
          "planet": {
            "@type": "planet",
            "id": "{handle:a:-sc1}"
          },
          "orbitalPeriod": 0.32
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "satellite",
          "id": "{handle:a:-sc1s}",
          "planet": {
            "@type": "planet",
            "id": "{handle:a:-sc1}"
          },
          "orbitalPeriod": 0.32,
          "provMetadata": {
            "spClientId": "{regacc:a}"
          }
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
