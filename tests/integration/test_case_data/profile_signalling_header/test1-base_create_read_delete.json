{
  "markers": [
    "smoke"
  ],
  "test_id": "test1-base_create_read_delete",
  "description": "Under the base profile, with no element of the epp or rri profile, a contact and a domain are created, the domain is read and deleted on every server.",
  "when": {
    "env.profile_signalling": "header"
  },
  "comment": "Skipped on rri-mtest: MTEST's config signals the profile by media type; the twin in profile_signalling_media_type/ covers it.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "Content-Type": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "RPP-Profile": "profile=urn:ietf:params:rpp:profile:base;version=1.0"
        },
        "body_json": {
          "select": [
            {
              "when": {
                "profile.contact.authInfo.supported": true
              },
              "then": {
                "@type": "contact",
                "id": "{handle:a:PB1}",
                "contactInfo": {
                  "@type": "Card",
                  "version": "2.0",
                  "kind": "individual",
                  "name": {
                    "full": "Erika Mustermann"
                  },
                  "addresses": {
                    "addr": {
                      "components": [
                        {
                          "kind": "name",
                          "value": "Musterweg 12"
                        },
                        {
                          "kind": "locality",
                          "value": "Frankfurt am Main"
                        },
                        {
                          "kind": "postcode",
                          "value": "60596"
                        }
                      ],
                      "countryCode": "DE"
                    }
                  },
                  "emails": {
                    "email": {
                      "address": "erika@example.com"
                    }
                  },
                  "phones": {
                    "voice": {
                      "number": "tel:+49.6912345678",
                      "features": {
                        "voice": true
                      }
                    }
                  }
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            },
            {
              "then": {
                "@type": "contact",
                "id": "{handle:a:PB1}",
                "contactInfo": {
                  "@type": "Card",
                  "version": "2.0",
                  "kind": "individual",
                  "name": {
                    "full": "Erika Mustermann"
                  },
                  "addresses": {
                    "addr": {
                      "components": [
                        {
                          "kind": "name",
                          "value": "Musterweg 12"
                        },
                        {
                          "kind": "locality",
                          "value": "Frankfurt am Main"
                        },
                        {
                          "kind": "postcode",
                          "value": "60596"
                        }
                      ],
                      "countryCode": "DE"
                    }
                  },
                  "emails": {
                    "email": {
                      "address": "erika@example.com"
                    }
                  },
                  "phones": {
                    "voice": {
                      "number": "tel:+49.6912345678",
                      "features": {
                        "voice": true
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Profile": "profile=urn:ietf:params:rpp:profile:base;version=1.0"
        },
        "body": {
          "@type": "contact",
          "id": "{handle:a:PB1}"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "Content-Type": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "RPP-Profile": "profile=urn:ietf:params:rpp:profile:base;version=1.0"
        },
        "body_json": {
          "select": [
            {
              "when": {
                "profile.domainName.dns.min_count": {
                  "min": 1
                }
              },
              "then": {
                "@type": "domainName",
                "name": "b1-{random_id_10}.{tld}",
                "registrant": {
                  "@type": "contact",
                  "id": "{handle:a:PB1}"
                },
                "dns": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            },
            {
              "then": {
                "@type": "domainName",
                "name": "b1-{random_id_10}.{tld}",
                "registrant": {
                  "@type": "contact",
                  "id": "{handle:a:PB1}"
                },
                "authInfo": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Profile": "profile=urn:ietf:params:rpp:profile:base;version=1.0"
        },
        "body": {
          "@type": "domainName",
          "name": "b1-{random_id_10}.{tld}",
          "registrant": {
            "id": "{handle:a:PB1}"
          }
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/domainNames/b1-{random_id_10}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "RPP-Profile": "profile=urn:ietf:params:rpp:profile:base;version=1.0",
          "Content-Type": "application/rpp+json"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "@type": "domainName",
          "registrant": {
            "@type": "contact",
            "id": "{handle:a:PB1}"
          }
        },
        "headers": {
          "RPP-Profile": "profile=urn:ietf:params:rpp:profile:base;version=1.0"
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "url": "/domainNames/b1-{random_id_10}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "RPP-Profile": "profile=urn:ietf:params:rpp:profile:base;version=1.0",
          "Content-Type": "application/rpp+json"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Profile": "profile=urn:ietf:params:rpp:profile:base;version=1.0"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/domainNames/b1-{random_id_10}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "RPP-Profile": "profile=urn:ietf:params:rpp:profile:base;version=1.0",
          "Content-Type": "application/rpp+json"
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "env.domainName.processes.delete.readable_after": true
            },
            "then": {
              "status": 200,
              "body": {
                "@type": "domainName",
                "status": [
                  {
                    "@type": "domainStatus",
                    "label": "pendingDelete"
                  }
                ],
                "provMetadata": {
                  "spClientId": "unknown"
                }
              },
              "headers": {
                "RPP-Profile": "profile=urn:ietf:params:rpp:profile:base;version=1.0"
              }
            }
          },
          {
            "then": {
              "status": 404,
              "headers": {
                "RPP-Code": "02303",
                "RPP-Profile": "profile=urn:ietf:params:rpp:profile:base;version=1.0"
              },
              "content_type": "application/problem+json",
              "body": {
                "type": "urn:ietf:params:rpp:error"
              }
            }
          }
        ]
      }
    }
  ]
}
