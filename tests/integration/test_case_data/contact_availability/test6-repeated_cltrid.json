{
  "test_id": "test6-repeated_cltrid",
  "steps": [
    {
      "comment": "Checks whether contact a6 is available, with a fixed RPP-Cltrid; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:-a6}/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "repcontact-{random_id_10}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "contactAvailability",
          "available": true
        },
        "content_type": "application/rpp+json"
      }
    },
    {
      "comment": "Checks whether contact a6 is available, with a fixed RPP-Cltrid; expects 500 02400. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:-a6}/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "repcontact-{random_id_10}"
        }
      },
      "response": {
        "select": [
          {
            "when": {
              "env.session.cltrid_reuse_supported": false
            },
            "then": {
              "status": 500,
              "headers": {
                "RPP-Code": "02400"
              },
              "body": {
                "type": "urn:ietf:params:rpp:error"
              },
              "content_type": "application/problem+json"
            }
          },
          {
            "then": {
              "status": 200,
              "headers": {
                "RPP-Code": "01000"
              },
              "body": {
                "@type": "contactAvailability",
                "available": true
              },
              "content_type": "application/rpp+json"
            }
          }
        ]
      }
    }
  ]
}
