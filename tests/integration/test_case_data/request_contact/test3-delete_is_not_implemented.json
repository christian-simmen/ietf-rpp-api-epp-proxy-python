{
  "description": "RRI cannot delete a contact: the registry deletes unused ones itself.",
  "steps": [
    {
      "comment": "Creates request contact RQ3 with uriTemplate; expects 201 01000. Setup: the request contact the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/requestContacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "requestContact",
          "id": "{handle:a:RQ3}",
          "uriTemplate": "https://example.com/contact?domain={Alabel}"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "requestContact",
          "id": "{handle:a:RQ3}",
          "uriTemplate": "https://example.com/contact?domain={Alabel}"
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          }
        }
      }
    },
    {
      "comment": "Deletes request contact RQ3; expects 501 02101. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/requestContacts/{handle:a:RQ3}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02101"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
