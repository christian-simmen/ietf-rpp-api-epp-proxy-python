{
  "markers": [
    "smoke"
  ],
  "test_id": "test9-without_parameters_the_default_preset_applies",
  "description": "Without preset parameters in the Accept and Content-Type, or with no Content-Type and a wildcard Accept, the default preset of the server applies and is named in the Content-Type of the response (core 14.3).",
  "when": {
    "env.preset_signalling": "media-type"
  },
  "steps": [
    {
      "when": {
        "profile.default_preset": "epp-compatible"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json",
          "Content-Type": "application/rpp+json"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Preset": null,
          "Vary": "Accept",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:epp-compatible\"; preset-version=\"1.0\""
        },
        "body": {
          "@type": "discovery"
        }
      }
    },
    {
      "when": {
        "profile.default_preset": "epp-compatible"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "*/*"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Preset": null,
          "Vary": "Accept",
          "Content-Type": "application/rpp+json; preset=\"urn:ietf:params:rpp:preset:epp-compatible\"; preset-version=\"1.0\""
        },
        "body": {
          "@type": "discovery"
        }
      }
    },
    {
      "when": {
        "profile.default_preset": "rri"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json",
          "Content-Type": "application/rpp+json"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Preset": null,
          "Vary": "Accept",
          "Content-Type": "application/rpp+json; preset=\"de.denic.rpp.preset.rri\"; preset-version=\"1.0\""
        },
        "body": {
          "@type": "discovery"
        }
      }
    },
    {
      "when": {
        "profile.default_preset": "rri"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "*/*"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Preset": null,
          "Vary": "Accept",
          "Content-Type": "application/rpp+json; preset=\"de.denic.rpp.preset.rri\"; preset-version=\"1.0\""
        },
        "body": {
          "@type": "discovery"
        }
      }
    }
  ]
}
