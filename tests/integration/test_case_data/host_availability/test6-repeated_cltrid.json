{
  "test_id": "test6-repeated_cltrid",
  "steps": [
    {
      "comment": "Checks whether host t6.….net is available, with a fixed RPP-Cltrid; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "GET",
        "url": "/hosts/t6.{random_name}.net/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "repeated-{random_id_10}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "hostAvailability",
          "available": true
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Checks whether host t6.….net is available, with a fixed RPP-Cltrid; expects 500 02400. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/hosts/t6.{random_name}.net/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "repeated-{random_id_10}"
        }
      },
      "response": {
        "status": 500,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02400"
        }
      }
    }
  ]
}
