{
  "test_id": "test4-ack_with_content",
  "steps": [
    {
      "comment": "Acknowledges message MSG37-nosuch; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/messages/MSG37-nosuch-{random_id_10}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "message"
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02001"
        }
      }
    }
  ]
}
