{
  "test_id": "test10-no_element_matches",
  "steps": [
    {
      "comment": "Creates contact HU10; expects 201. Setup: the registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:HU10}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "comment": "Creates host ns1.u10 with dns records ns; expects 201. Setup: a nameserver of the domain below. Only where the backend has host objects.",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.u10-{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.u10-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "hostName": "ns1.u10-{random_name}.net"
        }
      }
    },
    {
      "comment": "Creates host ns2.u10 with dns records ns; expects 201. Setup: a nameserver of the domain below. Only where the backend has host objects.",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns2.u10-{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.u10-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "hostName": "ns2.u10-{random_name}.net"
        }
      }
    },
    {
      "comment": "Creates domain up-test10 with authInfo, registrant HU10 (by backend), dns records a (by backend); expects 201. Setup: the domain the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "up-test10-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU10}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {}
      }
    },
    {
      "comment": "Patches domain up-test10: add /nameservers; expects 200. The operation this case checks. Only where the backend has host objects.",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test10-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/nameservers",
            "value": {
              "@type": "host",
              "hostName": "ns1.u10-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {}
      }
    },
    {
      "comment": "Patches domain up-test10: replace /nameservers with a match no name server has; expects 422 02308. The error answer this case checks. Only where the backend has host objects.",
      "when": {
        "profile.objects": {
          "contains": "host"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test10-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/nameservers",
            "match": {
              "hostName": "ns9.u10-{random_name}.net"
            },
            "value": {
              "@type": "host",
              "hostName": "ns2.u10-{random_name}.net"
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error",
          "status": 422,
          "errors": [
            {
              "result": "02308"
            }
          ]
        },
        "headers": {
          "RPP-Code": "02308"
        }
      }
    },
    {
      "comment": "Patches domain up-test10: replace /dns/records with a match no record has; expects 422 02308. The error answer this case checks. Only where name servers are dns records, not host objects.",
      "when": {
        "profile.objects": {
          "not": {
            "contains": "host"
          }
        }
      },
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test10-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/dns/records",
            "match": {
              "type": "a",
              "rdata": {
                "address": "192.0.2.99"
              }
            },
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "a",
              "rdata": {
                "address": "192.0.2.11"
              }
            }
          }
        ]
      },
      "response": {
        "status": 422,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error",
          "status": 422,
          "errors": [
            {
              "result": "02308"
            }
          ]
        },
        "headers": {
          "RPP-Code": "02308"
        }
      }
    },
    {
      "comment": "Deletes domain up-test10; expects 200. Cleanup: MTEST keeps what a case creates, so the case deletes it.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/up-test10-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        }
      },
      "response": {
        "status": 200
      }
    }
  ]
}
