{
  "test_id": "test1-label_of_63",
  "description": "A label of 63 characters (RFC 1035 §2.3.4).",
  "steps": [
    {
      "comment": "Creates host h1 (a label of 63).net with dns records ns; expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "{pad:63:h1-{random_name}}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "{pad:63:h1-{random_name}}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Reads host h1 (a label of 63).net; expects 200. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/hosts/{pad:63:h1-{random_name}}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "hostName": "{pad:63:h1-{random_name}}.net"
        }
      }
    }
  ]
}
