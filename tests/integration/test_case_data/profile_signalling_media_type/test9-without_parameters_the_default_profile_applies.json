{
  "markers": [
    "smoke"
  ],
  "test_id": "test9-without_parameters_the_default_profile_applies",
  "description": "Without profile parameters in the Accept and Content-Type, or with no Content-Type and a wildcard Accept, the default profile of the server applies and is named in the Content-Type of the response (core 14.3).",
  "when": {
    "env.profile_signalling": "media-type"
  },
  "comment": "Skipped on epp-docker: the EPP config signals the profile by the RPP-Profile header; profile_signalling_header/ covers the header method.",
  "steps": [
    {
      "comment": "Reads the discovery document, with Content-Type application/rpp+json, Accept application/rpp+json; expects 200 01000. The operation this case checks. Only where the default profile is epp (epp-docker).",
      "when": {
        "profile.default_profile": "epp"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json",
          "Content-Type": "application/rpp+json"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Profile": null,
          "Vary": "Accept",
          "Content-Type": "application/rpp+json; profile=\"urn:ietf:params:rpp:profile:epp-compatibility\"; profile-version=\"1.0\""
        },
        "body": {
          "@type": "discovery"
        }
      }
    },
    {
      "comment": "Reads the discovery document, with Accept */*; expects 200 01000. Reads what the steps above created. Only where the default profile is epp (epp-docker).",
      "when": {
        "profile.default_profile": "epp"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "*/*"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Profile": null,
          "Vary": "Accept",
          "Content-Type": "application/rpp+json; profile=\"urn:ietf:params:rpp:profile:epp-compatibility\"; profile-version=\"1.0\""
        },
        "body": {
          "@type": "discovery"
        }
      }
    },
    {
      "comment": "Reads the discovery document, with Content-Type application/rpp+json, Accept application/rpp+json; expects 200 01000. Reads what the steps above created. Only where the default profile is rri (rri-mtest).",
      "when": {
        "profile.default_profile": "rri"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "application/rpp+json",
          "Content-Type": "application/rpp+json"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Profile": null,
          "Vary": "Accept",
          "Content-Type": "application/rpp+json; profile=\"de.denic.rpp.profile.rri\"; profile-version=\"1.0\""
        },
        "body": {
          "@type": "discovery"
        }
      }
    },
    {
      "comment": "Reads the discovery document, with Accept */*; expects 200 01000. Reads what the steps above created. Only where the default profile is rri (rri-mtest).",
      "when": {
        "profile.default_profile": "rri"
      },
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Accept": "*/*"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000",
          "RPP-Profile": null,
          "Vary": "Accept",
          "Content-Type": "application/rpp+json; profile=\"de.denic.rpp.profile.rri\"; profile-version=\"1.0\""
        },
        "body": {
          "@type": "discovery"
        }
      }
    }
  ]
}
