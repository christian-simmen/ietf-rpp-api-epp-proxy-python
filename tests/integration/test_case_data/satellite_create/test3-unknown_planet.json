{
  "test_id": "test3-unknown_planet",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/satellites",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "satellite",
          "id": "{handle:a:-sc3s}",
          "planet": {
            "@type": "planet",
            "id": "{handle:a:-sc3}"
          },
          "orbitalPeriod": 0.32
        }
      },
      "response": {
        "status": 404,
        "content_type": "application/problem+json",
        "body": {
          "status": 404
        },
        "headers": {
          "RPP-Code": "02303"
        }
      }
    }
  ]
}
