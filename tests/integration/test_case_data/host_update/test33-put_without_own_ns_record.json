{
  "test_id": "test33-put_without_own_ns_record",
  "steps": [
    {
      "comment": "Creates host t33.….net with dns records ns; expects 201 01000. Setup: the host the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t33.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t33.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Replaces host t33.….net by a full update; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "PUT",
        "url": "/hosts/t33.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t33.{random_name}.net"
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
