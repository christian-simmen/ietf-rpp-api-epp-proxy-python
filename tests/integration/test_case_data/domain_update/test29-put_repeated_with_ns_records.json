{
  "when": {
    "profile.objects": {
      "contains": "host"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no host objects (a name server is an ns record of the domain).",
  "test_id": "test29-put_repeated_with_ns_records",
  "steps": [
    {
      "comment": "Creates contact HU29; expects 201. Setup: the registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:HU29}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "comment": "Creates host ns1.u29 with dns records ns; expects 201. Setup: a nameserver of the domain below.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.u29-{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.u29-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "hostName": "ns1.u29-{random_name}.net"
        }
      }
    },
    {
      "comment": "Creates host ns2.u29 with dns records ns; expects 201. Setup: a nameserver of the domain below.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns2.u29-{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.u29-{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "hostName": "ns2.u29-{random_name}.net"
        }
      }
    },
    {
      "comment": "Creates domain put29 with authInfo, 2 nameservers, registrant HU29 (by backend); expects 201 01000. Setup: the domain the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "put29-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "nameservers": [
            {
              "@type": "host",
              "hostName": "ns1.u29-{random_name}.net"
            },
            {
              "@type": "host",
              "hostName": "ns2.u29-{random_name}.net"
            }
          ],
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU29}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Replaces domain put29 by a full update with dns records 2 ns, registrant HU29 (by backend); expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/put29-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.u29-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.u29-{random_name}.net."
                }
              }
            ]
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU29}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "nameservers": [
            {
              "@type": "host",
              "hostName": "{upper:ns1.u29-{random_name}.net}"
            },
            {
              "@type": "host",
              "hostName": "{upper:ns2.u29-{random_name}.net}"
            }
          ]
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "comment": "Replaces domain put29 by a full update with dns records 2 ns, registrant HU29 (by backend); expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/domainNames/put29-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.u29-{random_name}.net."
                }
              },
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns2.u29-{random_name}.net."
                }
              }
            ]
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HU29}"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName",
          "nameservers": [
            {
              "@type": "host",
              "hostName": "{upper:ns1.u29-{random_name}.net}"
            },
            {
              "@type": "host",
              "hostName": "{upper:ns2.u29-{random_name}.net}"
            }
          ]
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
