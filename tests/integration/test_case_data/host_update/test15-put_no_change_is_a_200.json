{
  "test_id": "test15-put_no_change",
  "steps": [
    {
      "comment": "Creates host t15.….net with dns records ns; expects 201 01000. Setup: the host the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t15.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t15.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Replaces host t15.….net by a full update with dns records ns; expects 200 01000. The operation this case checks.",
      "request": {
        "method": "PUT",
        "url": "/hosts/t15.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t15.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t15.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "content_type": "application/rpp+json",
        "body": {
          "@type": "host",
          "hostName": "t15.{random_name}.net"
        }
      }
    }
  ],
  "description": "A full update that repeats the stored host sends no EPP update and answers 200 with the host (core §16.8), see spec-issues.md (Full update without a change)."
}
