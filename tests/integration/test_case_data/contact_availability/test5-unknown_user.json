{
  "test_id": "test5-unknown_user",
  "steps": [
    {
      "comment": "Checks whether contact a5 is available as a user the server does not know; expects 401 02200. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:-a5}/availability",
        "headers": {
          "Authorization": "{auth:unknown_user}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 401,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02200"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
