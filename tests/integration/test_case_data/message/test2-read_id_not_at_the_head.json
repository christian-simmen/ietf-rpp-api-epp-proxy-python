{
  "test_id": "test2-read_id_not_at_the_head",
  "steps": [
    {
      "comment": "Reads message MSG37-nosuch; expects one of 404 02303 or 501 02102. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/messages/MSG37-nosuch-{random_id_10}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "any_of": [
          {
            "status": 501,
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            },
            "headers": {
              "RPP-Code": "02102"
            }
          },
          {
            "status": 404,
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            },
            "headers": {
              "RPP-Code": "02303"
            }
          }
        ]
      }
    },
    {
      "comment": "Reads message MSG37-nosuch as registrar b; expects one of 404 02303 or 501 02102. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/messages/MSG37-nosuch-{random_id_10}",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "any_of": [
          {
            "status": 404,
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            },
            "headers": {
              "RPP-Code": "02303"
            }
          },
          {
            "status": 501,
            "content_type": "application/problem+json",
            "body": {
              "type": "urn:ietf:params:rpp:error"
            },
            "headers": {
              "RPP-Code": "02102"
            }
          }
        ]
      }
    }
  ]
}
