{
  "test_id": "test3-remove_radius",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/planets",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": {
          "@type": "planet",
          "id": "{handle:a:-pu3}",
          "type": "rocky",
          "radius": 3389.5,
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Secret-Word1"
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "planet",
          "id": "{handle:a:-pu3}"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "/planets/{handle:a:-pu3}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        },
        "body_json": [
          {
            "op": "remove",
            "path": "/radius"
          }
        ]
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "planet",
          "id": "{handle:a:-pu3}"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "/planets/{handle:a:-pu3}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "planet",
          "id": "{handle:a:-pu3}"
        },
        "headers": {
          "RPP-Code": "01000"
        }
      }
    }
  ]
}
