{
  "test_id": "test7-no_auth",
  "steps": [
    {
      "comment": "Patches domain up-test7: replace /authInfo without credentials, with a fixed RPP-Cltrid; expects 401. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test7-{random_name}.{tld}",
        "headers": {
          "RPP-Cltrid": "up-test7-{random_name}-clTRID",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "replace",
            "path": "/authInfo",
            "value": {
              "@type": "authInfo",
              "method": "authinfo",
              "authdata": "NewAbc2345678"
            }
          }
        ]
      },
      "response": {
        "status": 401,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "up-test7-{random_name}-clTRID"
        }
      }
    }
  ]
}
