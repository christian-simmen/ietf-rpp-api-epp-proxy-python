{
  "test_id": "test8-record_for_another_name",
  "steps": [
    {
      "comment": "Creates host t8.….net with dns records a; expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t8.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "www.t8.{random_name}.net.",
                "type": "a",
                "rdata": {
                  "address": "192.0.2.1"
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02102"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
