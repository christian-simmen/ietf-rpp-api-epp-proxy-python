{
  "markers": ["smoke"],
  "test_id": "test1-query_head",
  "steps": [
    {
      "comment": "Polls the message queue; expects one of 200 01300 or 200 01301. The operation this case checks.",
      "request": {
        "method": "GET",
        "url": "/messages",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "any_of": [
          {
            "status": 200,
            "content_type": "application/rpp+json",
            "body": [],
            "headers": {
              "RPP-Code": "01300",
              "RPP-Queue-Size": "0"
            }
          },
          {
            "status": 200,
            "content_type": "application/rpp+json",
            "body": [
              {
                "@type": "message",
                "status": "queued"
              }
            ],
            "headers": {
              "RPP-Code": "01301",
              "RPP-Queue-Size": {
                "type": "not_null"
              }
            }
          }
        ]
      }
    },
    {
      "comment": "Polls the message queue (type=transferRequestMessage) as registrar b; expects one of 200 01300 or 200 01301. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/messages?type=transferRequestMessage",
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "any_of": [
          {
            "status": 200,
            "content_type": "application/rpp+json",
            "body": [],
            "headers": {
              "RPP-Code": "01300",
              "RPP-Queue-Size": "0"
            }
          },
          {
            "status": 200,
            "content_type": "application/rpp+json",
            "body": [
              {
                "@type": "message",
                "status": "queued"
              }
            ],
            "headers": {
              "RPP-Code": "01301",
              "RPP-Queue-Size": {
                "type": "not_null"
              }
            }
          }
        ]
      }
    }
  ]
}
