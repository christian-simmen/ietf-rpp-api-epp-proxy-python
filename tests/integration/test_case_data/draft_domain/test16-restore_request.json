{
  "when": {
    "wait.domainName.processes.create.add_grace_period": true
  },
  "test_id": "test16-restore_request",
  "steps": [
    {
      "comment": "Creates contact HR16; expects 201. Setup: the registrant of the domain below. Only where a domain needs a registrant (rri-mtest).",
      "when": {
        "profile.domainName.registrant.min_count": {
          "min": 1
        }
      },
      "request": {
        "method": "POST",
        "url": "/contacts",
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:HR16}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "comment": "Creates domain ex16 with authInfo, registrant HR16 (by backend), dns records a (by backend); expects 201. Setup: the domain the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "domainName",
          "name": "ex16-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          },
          "registrant": {
            "select": [
              {
                "when": {
                  "profile.domainName.registrant.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "contact",
                  "id": "{handle:a:HR16}"
                }
              },
              {
                "omit": true
              }
            ]
          },
          "dns": {
            "select": [
              {
                "when": {
                  "profile.domainName.dns.min_count": {
                    "min": 1
                  }
                },
                "then": {
                  "@type": "dnsData",
                  "records": [
                    {
                      "@type": "dnsRecord",
                      "name": "@",
                      "type": "a",
                      "rdata": {
                        "address": "192.0.2.10"
                      }
                    }
                  ]
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Deletes domain ex16; expects 200. The operation this case checks. Waits first for domainName.processes.create.add_grace_period.",
      "wait": "domainName.processes.create.add_grace_period",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/ex16-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    },
    {
      "comment": "Requests a restore of domain ex16; expects 200. The operation this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/ex16-{random_name}.{tld}/processes/restoreProcesses",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "restoreProcess"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "restoreProcess",
          "restoreStatus": {
            "select": [
              {
                "when": {
                  "profile.domainName.processes.restore.report_supported": true
                },
                "then": "pendingRestore"
              },
              {
                "then": "restored"
              }
            ]
          }
        }
      }
    }
  ]
}
