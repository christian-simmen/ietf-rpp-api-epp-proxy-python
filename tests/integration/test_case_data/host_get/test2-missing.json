{
  "test_id": "test2-missing",
  "steps": [
    {
      "comment": "Reads host t2.….net; expects 404 02303. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/hosts/t2.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 404,
        "headers": {
          "RPP-Code": "02303"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
