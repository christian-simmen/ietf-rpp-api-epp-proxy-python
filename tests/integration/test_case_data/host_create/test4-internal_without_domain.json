{
  "test_id": "test4-internal_without_domain",
  "steps": [
    {
      "comment": "Creates host ns1.t4 with dns records ns; expects 404 02303. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "ns1.t4-{random_name}.{tld}",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "ns1.t4-{random_name}.{tld}."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 404,
        "headers": {
          "RPP-Code": "02303"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
