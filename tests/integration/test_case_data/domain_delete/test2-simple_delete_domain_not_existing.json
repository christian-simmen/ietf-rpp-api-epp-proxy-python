{
  "test_id": "test2-simple_delete_domain_not_existing",
  "steps": [
    {
      "comment": "Deletes domain test2, with a fixed RPP-Cltrid; expects 404. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/test2-{random_name}.{tld}",
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "test2-{random_name}-clTRID",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}"
        }
      },
      "response": {
        "status": 404,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "test2-{random_name}-clTRID"
        }
      }
    }
  ]
}
