{
  "test_id": "test4-request_with_body_json_and_content_type",
  "steps": [
    {
      "comment": "Deletes domain test4, with a fixed RPP-Cltrid; expects 400. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/test4-{random_name}.{tld}",
        "body_json": {
          "@type": "domainName",
          "name": "NOT-FREE.EXAMPLE",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Abc2345678"
          }
        },
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "test4-{random_name}-clTRID",
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}"
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "test4-{random_name}-clTRID"
        }
      }
    }
  ]
}
