{
  "description": "A template has 8 to 1024 characters (docs/rri/rri-extension.md); the proxy refuses a shorter one before any command.",
  "steps": [
    {
      "comment": "Creates request contact RQ6 with uriTemplate; expects 400 02001. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/requestContacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "requestContact",
          "id": "{handle:a:RQ6}",
          "uriTemplate": "http://"
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02001"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
