{
  "when": {
    "profile.domainName.contacts.labels": {
      "contains": "admin"
    }
  },
  "comment": "Skipped on rri-mtest: RRI has no admin, tech or billing contacts. Review: The case checks a schema refusal before any command; the admin label is incidental to it.",
  "test_id": "test6-invalid_schema",
  "steps": [
    {
      "comment": "Patches domain up-test6: add /contacts tech, with a fixed RPP-Cltrid; expects 400. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/domainNames/up-test6-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "RPP-Cltrid": "up-test6-{random_name}-clTRID",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/contacts",
            "value": {
              "label": "tech"
            }
          }
        ]
      },
      "response": {
        "status": 400,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "up-test6-{random_name}-clTRID"
        }
      }
    }
  ]
}
