{
  "test_id": "test36-patch_add_only_own_ns_record",
  "steps": [
    {
      "comment": "Creates host t36.….net with dns records ns; expects 201 01000. Setup: the host the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/hosts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "host",
          "hostName": "t36.{random_name}.net",
          "dns": {
            "@type": "dnsData",
            "records": [
              {
                "@type": "dnsRecord",
                "name": "@",
                "type": "ns",
                "rdata": {
                  "nsdname": "t36.{random_name}.net."
                }
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "host"
        }
      }
    },
    {
      "comment": "Patches host t36.….net: add /dns/records; expects 400 02003. The error answer this case checks.",
      "request": {
        "method": "PATCH",
        "url": "/hosts/t36.{random_name}.net",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": [
          {
            "op": "add",
            "path": "/dns/records",
            "value": {
              "@type": "dnsRecord",
              "name": "@",
              "type": "ns",
              "rdata": {
                "nsdname": "t36.{random_name}.net."
              }
            }
          }
        ]
      },
      "response": {
        "status": 400,
        "headers": {
          "RPP-Code": "02003"
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "content_type": "application/problem+json"
      }
    }
  ]
}
