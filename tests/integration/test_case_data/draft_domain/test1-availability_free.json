{
  "test_id": "test1-availability_free",
  "steps": [
    {
      "comment": "Checks whether domain ex1 is available; expects 200. The operation this case checks.",
      "request": {
        "method": "GET",
        "url": "/domainNames/ex1-{random_name}.{tld}/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainNameAvailability",
          "available": true
        }
      }
    }
  ]
}
