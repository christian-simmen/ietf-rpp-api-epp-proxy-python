{
  "test_id": "test1-uname_is_unsupported",
  "steps": [
    {
      "comment": "Checks whether domain IDN bücher-a1 is available (uName=b%C3%BCcher.example); expects 501 02102. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/domainNames/{alabel:bücher-a1}.{tld}/availability?uName=b%C3%BCcher.example",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Code": "02102"
        }
      }
    }
  ]
}
