{
  "test_id": "test5-simple_delete_no_auth",
  "steps": [
    {
      "comment": "Deletes domain test5 without credentials, with a fixed RPP-Cltrid; expects 401. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/test5-{random_name}.{tld}",
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "test5-{random_name}-clTRID",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}"
        }
      },
      "response": {
        "status": 401,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "test5-{random_name}-clTRID"
        }
      }
    }
  ]
}
