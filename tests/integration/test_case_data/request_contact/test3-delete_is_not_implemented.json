{
  "description": "RRI cannot delete a contact: the registry deletes unused ones itself.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "/requestContacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "application/rpp+json"
        },
        "body_json": {
          "@type": "requestContact",
          "id": "{handle:a:RQ3}",
          "uriTemplate": "https://example.com/contact?domain={Alabel}"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "requestContact",
          "id": "{handle:a:RQ3}",
          "uriTemplate": "https://example.com/contact?domain={Alabel}"
        },
        "fields": {
          "provMetadata.spClientId": {
            "type": "not_null"
          }
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "url": "/requestContacts/{handle:a:RQ3}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "headers": {
          "RPP-Code": "02101"
        },
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}