{
  "test_id": "test11-process_id_not_supported",
  "steps": [
    {
      "comment": "Reads the restore process of domain rs11 (abc); expects 501 02101. The error answer this case checks.",
      "request": {
        "method": "GET",
        "url": "/domainNames/rs11-{random_name}.{tld}/processes/restoreProcesses/abc",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 501,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02101",
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
