{
  "test_id": "test6-other_client_renews",
  "steps": [
    {
      "comment": "Creates domain rn6 with authInfo; expects 201. Setup: the domain the steps below work on.",
      "request": {
        "method": "POST",
        "url": "/domainNames",
        "body_json": {
          "@type": "domainName",
          "name": "rn6-{random_name}.{tld}",
          "authInfo": {
            "@type": "authInfo",
            "method": "authinfo",
            "authdata": "Password1!@"
          }
        },
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        }
      },
      "response": {
        "status": 201,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        }
      }
    },
    {
      "comment": "Reads domain rn6; expects 200. Reads what the steps above created. Keeps expiry for later steps.",
      "request": {
        "method": "GET",
        "url": "/domainNames/rn6-{random_name}.{tld}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/rpp+json",
        "body": {
          "@type": "domainName"
        },
        "fields": {
          "expiryDate": {
            "type": "not_null"
          }
        }
      },
      "capture": {
        "expiry": "expiryDate"
      }
    },
    {
      "comment": "Renews domain rn6 with expiryDate, renewalPeriod as registrar b; expects 403 02201. The error answer this case checks.",
      "request": {
        "method": "POST",
        "url": "/domainNames/rn6-{random_name}.{tld}/processes/renewProcesses",
        "body_json": {
          "@type": "renewProcess",
          "expiryDate": "{capture:expiry}",
          "renewalPeriod": {
            "@type": "period",
            "value": 1,
            "unit": "y"
          }
        },
        "headers": {
          "Authorization": "{auth:b}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        }
      },
      "response": {
        "status": 403,
        "content_type": "application/problem+json",
        "headers": {
          "RPP-Code": "02201",
          "RPP-Svtrid": {
            "type": "not_empty_string"
          },
          "RPP-Cltrid": {
            "type": "not_empty_string"
          }
        },
        "body": {
          "type": "urn:ietf:params:rpp:error"
        }
      }
    }
  ]
}
