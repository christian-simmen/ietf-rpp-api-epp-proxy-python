{
  "test_id": "test3-availability_head_free",
  "steps": [
    {
      "comment": "Checks whether domain ex3 is available with HEAD; expects 200. The operation this case checks.",
      "request": {
        "method": "HEAD",
        "url": "/domainNames/ex3-{random_name}.{tld}/availability",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200
      }
    }
  ]
}
