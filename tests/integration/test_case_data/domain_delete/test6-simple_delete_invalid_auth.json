{
  "test_id": "test6-simple_delete_invalid_auth",
  "steps": [
    {
      "comment": "Deletes domain test6 as a user the server does not know, with a fixed RPP-Cltrid; expects 401. The error answer this case checks.",
      "request": {
        "method": "DELETE",
        "url": "/domainNames/test6-{random_name}.{tld}",
        "headers": {
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "test6-{random_name}-clTRID",
          "Authorization": "{auth:unknown_user}",
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}"
        }
      },
      "response": {
        "status": 401,
        "content_type": "application/problem+json",
        "body": {
          "type": "urn:ietf:params:rpp:error"
        },
        "headers": {
          "RPP-Cltrid": "test6-{random_name}-clTRID"
        }
      }
    }
  ]
}
