{
  "markers": [
    "smoke"
  ],
  "test_id": "test2-profile_schemas",
  "description": "Discovery lists the URL of the effective schema of each offered profile (extension profile-schemas): each is fetched, without authentication and without a profile header, as application/schema+json.",
  "steps": [
    {
      "comment": "Reads the discovery document without credentials; expects 200 01000. The operation this case checks. Keeps schemaA, schemaB for later steps.",
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Accept": "{rpp:accept}",
          "RPP-Profile": "{rpp:profile}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "discovery",
          "profileSchemas": {
            "select": [
              {
                "when": {
                  "profile.default_profile": "rri"
                },
                "then": [
                  {
                    "profile": "urn:ietf:params:rpp:profile:base",
                    "version": "1.0",
                    "url": "https://localhost:8000/profiles/urn%3Aietf%3Aparams%3Arpp%3Aprofile%3Abase/schema"
                  },
                  {
                    "profile": "de.denic.rpp.profile.rri",
                    "version": "1.0",
                    "url": "https://localhost:8000/profiles/de.denic.rpp.profile.rri/schema"
                  }
                ]
              },
              {
                "then": [
                  {
                    "profile": "urn:ietf:params:rpp:profile:base",
                    "version": "1.0",
                    "url": "https://localhost:8000/profiles/urn%3Aietf%3Aparams%3Arpp%3Aprofile%3Abase/schema"
                  },
                  {
                    "profile": "urn:ietf:params:rpp:profile:epp-compatibility",
                    "version": "1.0",
                    "url": "https://localhost:8000/profiles/urn%3Aietf%3Aparams%3Arpp%3Aprofile%3Aepp-compatibility/schema"
                  }
                ]
              }
            ]
          }
        }
      },
      "capture": {
        "schemaA": "profileSchemas.0.url",
        "schemaB": "profileSchemas.1.url"
      }
    },
    {
      "comment": "Reads the captured schemaA without credentials, with Accept application/schema+json; expects 200 01000. Follows a link the steps above captured.",
      "request": {
        "method": "GET",
        "url": "{capture:schemaA}",
        "headers": {
          "Accept": "application/schema+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/schema+json",
        "headers": {
          "RPP-Code": "01000",
          "RPP-Profile": null
        },
        "body": {
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      }
    },
    {
      "comment": "Reads the captured schemaB without credentials, with Accept application/schema+json; expects 200 01000. Follows a link the steps above captured.",
      "request": {
        "method": "GET",
        "url": "{capture:schemaB}",
        "headers": {
          "Accept": "application/schema+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/schema+json",
        "headers": {
          "RPP-Code": "01000",
          "RPP-Profile": null
        },
        "body": {
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      }
    }
  ]
}
