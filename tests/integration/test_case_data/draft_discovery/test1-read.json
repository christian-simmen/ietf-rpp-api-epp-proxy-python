{
  "markers": [
    "smoke"
  ],
  "test_id": "test1-read",
  "steps": [
    {
      "request": {
        "method": "GET",
        "url": "/.well-known/rpp",
        "headers": {
          "Accept": "application/rpp+json",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "RPP-Code": "01000"
        },
        "body": {
          "@type": "discovery",
          "versions": [
            {
              "@type": "discoveryVersion",
              "version": "1.0",
              "baseUrl": "https://localhost:8000"
            }
          ],
          "environment": {
            "@type": "discoveryEnvironment",
            "name": "{env:environment_name}",
            "status": "test"
          },
          "tlds": [
            "{tld}"
          ],
          "profiles": {
            "select": [
              {
                "when": {
                  "profile.objects": {
                    "contains": "host"
                  }
                },
                "then": [
                  "urn:ietf:params:rpp:profile:base",
                  "urn:ietf:params:rpp:profile:epp-compatibility"
                ]
              },
              {
                "then": [
                  "urn:ietf:params:rpp:profile:base",
                  "de.denic.rpp.profile.rri"
                ]
              }
            ]
          },
          "objects": {
            "select": [
              {
                "when": {
                  "profile.objects": {
                    "contains": "host"
                  }
                },
                "then": [
                  "domainName",
                  "host",
                  "contact"
                ]
              },
              {
                "then": [
                  "domainName",
                  "contact",
                  "requestContact"
                ]
              }
            ]
          },
          "extensions": {
            "select": [
              {
                "when": {
                  "profile.objects": {
                    "contains": "host"
                  }
                },
                "then": [
                  {
                    "@type": "extension",
                    "name": "RPP EPP Compatibility",
                    "id": "urn:ietf:params:rpp:extension:epp-compatibility",
                    "version": "1.0",
                    "url": "https://github.com/pawel-kow/ietf-rpp-api-epp-proxy-python/blob/main/.spec/epp-compatibility.schema.json"
                  }
                ]
              },
              {
                "then": [
                  {
                    "@type": "extension",
                    "name": "DENIC RRI",
                    "id": "de.denic.rpp.rri",
                    "version": "0.2.0",
                    "url": "https://github.com/pawel-kow/ietf-rpp-api-epp-proxy-python/blob/main/.spec/rri-extension.schema.json"
                  }
                ]
              }
            ]
          }
        },
        "fields": {
          "datetime": {
            "type": "not_empty_string"
          }
        }
      }
    }
  ]
}
