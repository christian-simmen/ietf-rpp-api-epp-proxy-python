{
  "test_id": "test6-name_of_255",
  "description": "A name of 255 characters, the most RFC 5733 and RRI hold, is stored whole.",
  "steps": [
    {
      "comment": "Creates contact Z6 with authInfo (by backend); expects 201. The create this case checks.",
      "request": {
        "method": "POST",
        "url": "/contacts",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "RPP-Cltrid": "{unique_cltrid}",
          "Content-Type": "{rpp:content-type}"
        },
        "body_json": {
          "@type": "contact",
          "id": "{handle:a:Z6}",
          "contactInfo": {
            "@type": "Card",
            "version": "2.0",
            "kind": "individual",
            "name": {
              "full": "Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann vonx"
            },
            "addresses": {
              "addr": {
                "components": [
                  {
                    "kind": "name",
                    "value": "Musterweg 12"
                  },
                  {
                    "kind": "locality",
                    "value": "Frankfurt am Main"
                  },
                  {
                    "kind": "postcode",
                    "value": "60596"
                  }
                ],
                "countryCode": "DE"
              }
            },
            "emails": {
              "email": {
                "address": "erika@example.com"
              }
            },
            "phones": {
              "voice": {
                "number": "tel:+49.6912345678",
                "features": {
                  "voice": true
                }
              }
            }
          },
          "authInfo": {
            "select": [
              {
                "when": {
                  "profile.contact.authInfo.supported": true
                },
                "then": {
                  "@type": "authInfo",
                  "method": "authinfo",
                  "authdata": "Abc2345678"
                }
              },
              {
                "omit": true
              }
            ]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "@type": "contact"
        }
      }
    },
    {
      "comment": "Reads contact Z6; expects 200. Reads what the steps above created.",
      "request": {
        "method": "GET",
        "url": "/contacts/{handle:a:Z6}",
        "headers": {
          "Authorization": "{auth:a}",
          "Accept": "{rpp:accept}",
          "RPP-Preset": "{rpp:preset}",
          "Content-Type": "{rpp:content-type}",
          "RPP-Cltrid": "{unique_cltrid}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "contactInfo": {
            "name": {
              "full": "Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann von Frankfurt am Main Erika Mustermann vonx"
            }
          }
        }
      }
    }
  ]
}
